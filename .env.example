# Copy this file to .env and fill in the required values. Uncomment override
# knobs only when the defaults don't fit the node.
# The scripts treat .env as shell syntax, so keep values quoted when they
# contain spaces or punctuation.
# See docs/CONFIGURATION.md for the full runtime model.

# Required receiver node identity and site.
RSDB_NODE_HOSTNAME=''
RSDB_RECEIVER_LAT='fill-me-in'
RSDB_RECEIVER_LON='fill-me-in'

# Node access overrides. Defaults use user rsdb, <RSDB_NODE_HOSTNAME>.local,
# and pi/secrets/rsdb_node_ed25519.
# RSDB_NODE_USER='rsdb'
# RSDB_NODE_HOST='192.0.2.10'
# RSDB_NODE_SSH_KEY='pi/secrets/rsdb_node_ed25519'
# RSDB_TIMEZONE='America/Los_Angeles'

# First-boot Wi-Fi provisioning. Leave commented when using Ethernet or an OS
# image configured another way.
# RSDB_WIFI_COUNTRY='US'
# RSDB_WIFI_SSID='your-network'
# RSDB_WIFI_PASSWORD='your-password'

# Receiver radio job. ADS-B / Mode S is the implemented decoder today. Future
# protocol keys are uat978, acars, vdl2, and ais.
# RSDB_PROTOCOL='adsb1090'
# RSDB_CENTER_FREQUENCY_HZ='1090000000'
# RSDB_SAMPLE_RATE_HZ='2000000'

# Local receiver diagnostics API. Uncomment only if port 8080 conflicts.
# RSDB_COLLECTOR_PORT='8080'

# Local aggregate ingest and UI service. The Pi defaults run a local aggregate
# on port 8090 and serve the UI from there.
# RSDB_AGGREGATE_SERVICE_ENABLED='auto'
# RSDB_AGGREGATE_HOST='0.0.0.0'
# RSDB_AGGREGATE_PORT='8090'
# RSDB_ALLOWLIST='/etc/rsdb/allowlist.txt'
# RSDB_AGGREGATE_DATA_DIR='/var/lib/rsdb/aggregate'
# RSDB_AGGREGATE_RETENTION_HOURS='72'
# RSDB_AGGREGATE_HOT_MAX_MB='250'

# Signed receiver submission. The Pi defaults submit to the local aggregate.
# Add shared or remote aggregates to the same comma/space-separated URL list.
# RSDB_SIGNING_KEY_PATH='/etc/rsdb/receiver.seed'
# RSDB_SUBMIT_URLS='http://127.0.0.1:8090'
# Example with the shared RSDB aggregate:
# RSDB_SUBMIT_URLS='http://127.0.0.1:8090,https://rsdb.hackshare.com'
# Example with another remote aggregate:
# RSDB_SUBMIT_URLS='http://127.0.0.1:8090,https://aggregate.example.com'
# RSDB_SUBMIT_RETRY_SECONDS='5'
# RSDB_SUBMIT_OUTBOX_DIR='/var/lib/rsdb/submit'
# RSDB_SUBMIT_OUTBOX_MAX_MB='25'
